.DS_Store
node_modules/
dist/
dist-ssr/
*.local

# Vite / editor
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Claude Code: los comandos y skills de .claude/ si se versionan (los usa
# todo el equipo); los ajustes de permisos son de cada maquina.
.claude/settings.local.json

# Vercel: .vercel/ guarda el projectId y el orgId de cada maquina al enlazar
# el repo con el proyecto; no es configuracion compartida.
.vercel

# Datasets de la clienta (Instagram, fotos de manos): datos de terceros, no se
# versionan. Solo las etiquetas viven en services/vision/datasets/. Anclado con
# "/" para no ignorar esa carpeta.
/datasets/
*.zip
*.xlsx
